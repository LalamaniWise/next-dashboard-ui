# Copy to .env and fill in. Never commit .env.

# Database: SQLite locally, Turso (libSQL) in production
DATABASE_URL="file:./dev.db"
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Signs session cookies. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

SCHOOL_TIMEZONE=Africa/Johannesburg
# MATERIALS_DIR=   (default: ./storage/materials)
# BRANDING_DIR=
# GALLERY_DIR=     (default: ./storage/gallery, photos for the website's Gallery page)
# On hosts without a lasting disk (Vercel), keep uploads in a private Vercel
# Blob store instead of those folders (docs/deploy-vercel-turso.md)
# BLOB_READ_WRITE_TOKEN=

# Email for password reset links and sign-in codes (docs/email-setup.md)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="School name <school@example.com>"
# APP_URL=https://app.example.com

# Online classes
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_HOST_EMAIL=
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_ORGANIZER_EMAIL=

# AI lesson videos (ai/service/README.md). The secret must match
# VIDEO_SERVICE_SECRET in ai/service/.env.
VIDEO_SERVICE_URL=http://127.0.0.1:8765
VIDEO_SERVICE_SECRET=
