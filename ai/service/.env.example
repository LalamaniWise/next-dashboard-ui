# Copy to ai/service/.env (git-ignored) and fill in. See README.md.

# Must match VIDEO_SERVICE_SECRET in the app's .env. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VIDEO_SERVICE_SECRET=
VIDEO_SERVICE_PORT=8765

# Writes the lessons (Claude)
ANTHROPIC_API_KEY=

# YouTube (from Google Cloud; the refresh token comes from youtube_auth.py)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# private, unlisted or public. Until the Google Cloud project passes YouTube's
# API audit, YouTube makes every uploaded video private whatever you set here.
YOUTUBE_PRIVACY=unlisted
# The learners are high-school age, so the videos are not made for kids
YOUTUBE_MADE_FOR_KIDS=false

# The video cover (first 3 seconds and the YouTube thumbnail) and worksheets
# use the school's logo and name. Default logo: the app's public/logo.png.
# Use a PNG or JPG; if you upload a new logo in the app's Settings, point this at it.
SCHOOL_LOGO=
SCHOOL_NAME=Capital Mathematics Studies

# Your YouTube, TikTok and Facebook name. It goes on the cover, in the YouTube
# description and in the caption to share on TikTok and Facebook. Leave it
# empty to leave it off. The app's lists use LESSON_VIDEO_HANDLE in
# src/lib/lessonVideoOptions.ts, so change both.
SOCIAL_HANDLE=Lalamani Ramaru

# Piper voice files (only needed for the "piper" voice)
PIPER_VOICE_EN=
PIPER_VOICE_AF=

# l, m or h. Higher takes much longer to render.
RENDER_QUALITY=m

# Testing: DRY_RUN=1 renders the video but skips YouTube and returns a fake link.
# WRITER=sample uses the sample lesson instead of Claude (no API key needed).
DRY_RUN=0
WRITER=anthropic
